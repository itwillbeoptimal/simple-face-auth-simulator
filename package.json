{
  "name": "open-mission-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "core-server",
    "web-client",
    "app-client"
  ],
  "scripts": {
    "format": "prettier --write \"{core-server,web-client,app-client}/src/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"{core-server,web-client,app-client}/src/**/*.{ts,tsx}\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0"
  }
}
